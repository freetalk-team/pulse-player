{
  "name": "pulse-player",
  "version": "1.0.3",
  "description": "Modern, lightweight media player",
  "appname": "Pulse Player",
  "nsd": "pulseplayer",
  "main": "./out/main/index.js",
  "desktopName": "pulse-player.desktop",
  "author": {
    "name": "Freetalk Team",
    "email": "team.freetalk@gmail.com",
    "url": "https://www.sipme.io"
  },
  "contributors": [
    {
      "name": "Pavel Patarinski",
      "email": "pavelp.work@gmail.com"
    }
  ],
  "homepage": "https://www.sipme.io/player",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freetalk-team/pulse-player.git"
  },
  "config": {
    "port": "4321"
  },
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -- --no-sandbox --ozone-platform=x11",
    "debug": "RUST_BACKTRACE=full DEBUG_WORKER=1 electron-vite dev --remote-debugging-port=9222 -- --no-sandbox --dev",
    "server": "electron-vite dev -- headless",
    "build": "electron-vite build",
    "dev:web": "vite --config web.vite.config.mjs",
    "build:web": "vite build --config web.vite.config.mjs && cp resources/favicon.ico resources/web/",
    "build:release": "npm run build && npm run build:web",
    "build:icon": "cp resources/icon.png build/icon.png && convert build/icon.png -define icon:auto-resize=256,128,64,48,32,16 build/icon.ico",
    "build:web:icon": "convert resources/icon.png -define icon:auto-resize=256,128,64,48,32,16 resources/web/favicon.ico",
    "dev:demo": "vite --config demo.vite.config.mjs",
    "build:demo": "vite build --config demo.vite.config.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build:release && electron-builder --win",
    "build:mac": "npm run build:release && electron-builder --mac",
    "build:linux": "npm run build:release && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/gutter": "^0.19.9",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emoji-mart/data": "^1.2.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@freetalk-team/pulse-player-ffmpeg": "1.0.0",
    "bonjour-service": "^1.4.4",
    "cheerio": "^1.2.0",
    "dompurify": "^3.4.14",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "emoji-mart": "^5.6.0",
    "fastify": "^5.12.3",
    "marked": "^18.0.11",
    "source-map-support": "^0.5.21",
    "svelte-portal": "^2.2.1",
    "yaml": "^2.9.0",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.0",
    "svelte-dnd-action": "^0.9.79",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "vite": "^7.2.6"
  }
}
